#!/usr/bin/env python3
"""Resolve a session's readable agent-loom name ("Flying Cake").

agent-loom assigns one name per session and keeps it after the session ends,
which is what makes it readable from an exit path that runs after the agent is
gone. The name is asked of `agent-loom session-name`: agent-loom's store is
private to it, and its files move with its layout.

Two ways to ask, because the id agent-loom keyed on is not always the id a
launcher knows. agent-loom resolves its session id from CLAUDE_CODE_SESSION_ID,
then CODEX_THREAD_ID, then the launcher-minted AGENT_SESSION_ID -- so for Codex
the thread id wins and a launcher's own id finds nothing. `--host-pid` asks the
question the other way round: which session belonged to this agent process.
`--not-before` is the launch time, which rejects a record left by an earlier
process that had the same pid.

Exit 3 means no name, which is not an error. A session that never attached
agent-loom never had one, and neither an absent, outdated, or stalled
agent-loom may be what breaks an exit receipt.

Not on PATH: reached by absolute path from agent-epilogue and the launcher.
"""

from __future__ import annotations

import json
import os
import shutil
import signal
import subprocess
import sys

NO_NAME = 3
LOOKUP_SECONDS = 2


def ask_agent_loom(arguments: list[str]) -> str | None:
    """The display name agent-loom reports, or None.

    The lookup runs in its own process group and the whole group is killed on
    timeout: a killed process whose child still holds the output pipe would
    otherwise keep this waiting for the child. Where there are no process
    groups, the pipe is closed instead of drained.
    """
    agent_loom = shutil.which("agent-loom")
    if agent_loom is None:
        return None
    try:
        process = subprocess.Popen(
            [agent_loom, "session-name", *arguments, "--json"],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            start_new_session=True,
        )
    except OSError:
        # Not executable, a bad interpreter line, a vanished file: no name.
        return None
    try:
        output, _ = process.communicate(timeout=LOOKUP_SECONDS)
    except subprocess.TimeoutExpired:
        try:
            if hasattr(os, "killpg"):
                os.killpg(process.pid, signal.SIGKILL)
            else:
                process.kill()
        except ProcessLookupError:
            pass  # It finished between the timeout and the kill.
        # Wait for the process itself, not for its output: on Windows only the
        # process is killed, and a surviving child would hold the pipe open.
        if process.stdout is not None:
            process.stdout.close()
        process.wait()
        return None
    if process.returncode != 0:
        return None
    try:
        answer = json.loads(output)
    except ValueError:
        return None
    if not isinstance(answer, dict) or answer.get("schema") != "agent-loom-session-name/v1":
        return None
    name = answer.get("name")
    if not isinstance(name, dict):
        return None
    for key in ("displayName", "slug"):
        value = name.get(key)
        if isinstance(value, str) and value:
            return value
    return None


def main(argv: list[str]) -> int:
    forwarded: list[str] = []
    arguments = list(argv)
    while arguments:
        argument = arguments.pop(0)
        if argument == "--session-id" and arguments:
            forwarded += ["--session", arguments.pop(0)]
        elif argument == "--host-pid" and arguments:
            value = arguments.pop(0)
            if not value.isdigit():
                print(f"agent-mail-name: not a pid: {value}", file=sys.stderr)
                return 2
            forwarded += ["--host-pid", value]
        elif argument == "--not-before" and arguments:
            forwarded += ["--not-before", arguments.pop(0)]
        elif argument in ("--help", "-h"):
            print(__doc__.strip(), file=sys.stderr)
            return 0
        else:
            print(f"agent-mail-name: unexpected argument: {argument}", file=sys.stderr)
            return 2
    if not forwarded:
        return NO_NAME
    name = ask_agent_loom(forwarded)
    if name is None:
        return NO_NAME
    print(name)
    return 0


class _LookupTimeout(Exception):
    pass


def _lookup_timed_out(signum: int, frame: object) -> None:
    raise _LookupTimeout


if __name__ == "__main__":
    # A receipt must not hold up the next prompt, even on a stalled filesystem:
    # finding agent-loom on PATH can block on a dead mount before the lookup's
    # own bound starts. This backstop covers the whole run, one second later.
    if hasattr(signal, "SIGALRM"):
        signal.signal(signal.SIGALRM, _lookup_timed_out)
        signal.alarm(LOOKUP_SECONDS + 1)
    try:
        sys.exit(main(sys.argv[1:]))
    except _LookupTimeout:
        sys.exit(NO_NAME)
